# Public site URL (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: enables email delivery of inquiries via Resend (https://resend.com)
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
# Admin (/admin). Set both in .env.local; never use these as production values.
ADMIN_PASSWORD=
ADMIN_SECRET=
